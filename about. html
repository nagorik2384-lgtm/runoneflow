<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>About Us — RunOneFlow</title>

  <link rel="stylesheet" href="style.css">

  <link rel="preconnect"
        href="https://fonts.googleapis.com">

  <link rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>


<body>

  <main class="about-page">

    <!-- Background logo -->

    <img src="logo.PNG"
         class="about-logo"
         alt="RunOneFlow">


    <div class="about-container">


      <!-- Back -->

      <a href="index.html"
         class="back-button">

        <i class="fa-solid fa-arrow-left"></i>

        <span>Back</span>

      </a>


      <!-- Header -->

      <section class="about-header">

        <div class="small-label">
          RUNONEFLOW
        </div>

        <h1>
          About Us
        </h1>

        <p class="about-lead">
          Just run.<br>
          Just Flow.
        </p>

      </section>


      <!-- Main story -->

      <section class="about-card">

        <div class="card-icon">
          <i class="fa-solid fa-person-running"></i>
        </div>

        <h2>
          More than running.
        </h2>

        <p>
          RunOneFlow is a space created for people
          who run, move and keep going.
        </p>

        <p>
          We believe running is not only about distance,
          pace or results. It is about the feeling of
          movement, the people around you and the flow
          you find along the way.
        </p>

      </section>


      <!-- Mission -->

      <section class="about-grid">


        <div class="about-mini-card">

          <div class="mini-icon">
            <i class="fa-solid fa-link"></i>
          </div>

          <h3>
            Connect
          </h3>

          <p>
            Bringing runners, communities,
            places and ideas closer together.
          </p>

        </div>


        <div class="about-mini-card">

          <div class="mini-icon">
            <i class="fa-solid fa-compass"></i>
          </div>

          <h3>
            Discover
          </h3>

          <p>
            Find places, people, events and
            opportunities connected to running.
          </p>

        </div>


        <div class="about-mini-card">

          <div class="mini-icon">
            <i class="fa-solid fa-bolt"></i>
          </div>

          <h3>
            Move
          </h3>

          <p>
            Stay active, stay curious and
            keep moving forward.
          </p>

        </div>


      </section>


      <!-- Vision -->

      <section class="vision">

        <span>
          OUR VISION
        </span>

        <h2>
          One flow.<br>
          Many runners.
        </h2>

        <p>
          RunOneFlow is growing into a global
          running ecosystem where runners,
          communities and brands can meet
          in one place.
        </p>

      </section>


      <!-- Partners -->

      <section class="partner-card">

        <div>

          <span class="small-label">
            FOR BRANDS
          </span>

          <h2>
            Run with us.
          </h2>

          <p>
            We are building a platform where
            running-related brands can connect
            with an engaged running audience.
          </p>

        </div>


        <a href="index.html"
           class="premium-button">

          <span>
            Become a Partner
          </span>

          <i class="fa-solid fa-arrow-right"></i>

        </a>

      </section>


      <!-- Footer -->

      <footer class="about-footer">

        <span>
          © 2026 RunOneFlow
        </span>

        <span>
          Run. Flow. Connect.
        </span>

      </footer>


    </div>

  </main>


</body>

</html>